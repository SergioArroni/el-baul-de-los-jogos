{
  "name": "el-baul-de-los-jogos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run build && npm run android:sync && cd android && gradlew assembleDebug",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tests/tsconfig.json && tsc -p mcp/tsconfig.json && tsc -p api/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "npm run build && node tests/stack/run.mjs",
    "android:icons": "capacitor-assets generate --android",
    "mcp": "tsx mcp/local.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
